# Copy to .env.local for local development. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Public origin for email-confirmation and OAuth redirects.
# When unset, the origin is derived from the incoming request headers, so a
# deployed environment does not fall back to localhost. Set it only to pin a
# canonical domain (no trailing slash).
# NEXT_PUBLIC_SITE_URL=https://ravine.app
